<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- App Lock (§3.6) — BiometricPrompt with device PIN/pattern/password fallback.
         Normal-protection permission (not runtime-prompted); no new sensitive permission. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Notification reliability (§9.7) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- USE_EXACT_ALARM over SCHEDULE_EXACT_ALARM: auto-granted, no Settings-redirect flow
         needed. Play policy restricts USE_EXACT_ALARM to apps whose core function is
         alarms/reminders (which this genuinely is) — moot anyway since §1 rules out Play
         distribution entirely for this build. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- USE_EXACT_ALARM only exists from API 33. minSdk is 30, and targetSdk 36 means the
         API 31+ exact-alarm restriction applies, so on Android 12/12L (API 31-32) an exact
         alarm needs SCHEDULE_EXACT_ALARM instead — without it setExactAndAllowWhileIdle
         throws SecurityException there. Capped at 32 so API 33+ keeps using USE_EXACT_ALARM
         alone. AlarmScheduler still asks canScheduleExactAlarms() before every schedule,
         since SCHEDULE_EXACT_ALARM is user-revocable on 12/12L in a way USE_EXACT_ALARM
         isn't. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Optional Google Calendar sync (§3.2, §9.5) — the app's first real network call, gated
         behind the Calendar screen's own Connect action (§3.5's "zero network calls until
         toggled on" pattern). Nothing else in the app calls the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- System Calendar Provider registration (§3.2, §9.9 item 3) — mirrors Tendril's own
         dated Entries into CalendarContract via a local (ACCOUNT_TYPE_LOCAL) calendar, no
         Account/AbstractAccountAuthenticator/SyncAdapter service required (§3.2's
         corrected wording, see CalendarProviderSync's class doc). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".TendrilApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tendril"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Tendril.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- §9.7/§9.8 R4 — AlarmScheduler's receivers. All fired via explicit PendingIntent
             (or, for boot, a protected system broadcast) — none need to be exported. -->
        <receiver android:name=".notifications.OverdueAlarmReceiver" android:exported="false" />
        <receiver android:name=".notifications.ReminderAlarmReceiver" android:exported="false" />
        <receiver android:name=".notifications.EntryActionReceiver" android:exported="false" />
        <receiver android:name=".notifications.BootCompletedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- §8/§9.6 — Glance widgets (Date/Monthly grid/Agenda). Each receiver is exported
             (required for the launcher to bind it) but not otherwise reachable — no data or
             action beyond the standard AppWidget broadcasts. -->
        <receiver android:name=".widget.DateWidgetReceiver" android:exported="true"
            android:label="@string/widget_label_date">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/date_widget_info" />
        </receiver>
        <receiver android:name=".widget.MonthlyGridWidgetReceiver" android:exported="true"
            android:label="@string/widget_label_monthly_grid">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/monthly_widget_info" />
        </receiver>
        <receiver android:name=".widget.AgendaWidgetReceiver" android:exported="true"
            android:label="@string/widget_label_agenda">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_widget_info" />
        </receiver>
        <receiver android:name=".widget.HabitsWidgetReceiver" android:exported="true"
            android:label="@string/widget_label_habits">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/habits_widget_info" />
        </receiver>

        <!-- §8.7 — shared per-instance opacity/Shade/Hue configuration screen for all three
             widget types above. -->
        <activity
            android:name=".widget.AppWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.Tendril">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
